# Copy this file to .env and fill in your own values.
# .env is never committed / handed off with real secrets in it.

# Server port
PORT=5000

# MongoDB connection string.
# LEAVE THIS BLANK / COMMENTED OUT for zero-setup local testing:
# the server will automatically start its own local database on your machine
# (via mongodb-memory-server) and store data in server/data/db — nothing to install.
#
# When you're ready to deploy for real, set this to either:
#   - a local MongoDB you installed yourself:      mongodb://127.0.0.1:27017/shakticonnect
#   - a free MongoDB Atlas cluster (recommended):  mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/shakticonnect
# MONGODB_URI=

# Secret used to sign login tokens (JWT). Change this to any long random string before going live.
JWT_SECRET=change-this-to-a-long-random-string-before-deploying
JWT_EXPIRES_IN=7d

# Allowed origin for the frontend. Leave blank/commented out during local dev — the
# server will accept requests from whatever address you open the frontend at
# (localhost or 127.0.0.1, any port). Set this to your real frontend URL once deployed,
# e.g. CLIENT_ORIGIN=https://your-app.pages.dev
# CLIENT_ORIGIN=
